{
  "version": 1,
  "maxAttempts": 3,
  "checks": [
    { "id": "shellcheck", "kind": "command",
      "run": "shellcheck setup.sh plugins/*/*.sh plugins/*/skills/*/scripts/*.sh",
      "when": ["**/*.sh"], "autofix": true },
    { "id": "validate", "kind": "command",
      "run": "for p in plugins/*/; do claude plugin validate \"$p\" > /tmp/rinse-validate.txt 2>&1 || { cat /tmp/rinse-validate.txt; exit 1; }; done; echo all plugins valid",
      "when": ["plugins/**", ".claude-plugin/**"], "autofix": true },
    { "id": "mod-tests", "kind": "command",
      "run": "for p in plugins/*/; do ls \"$p\"hooks/*.test.ts >/dev/null 2>&1 || continue; claude plugin test \"$p\" || exit 1; done",
      "when": ["plugins/*/hooks/**"], "autofix": true },
    { "id": "typos", "kind": "command", "run": "typos plugins home README.md setup.md", "autofix": true },
    { "id": "gitleaks", "kind": "command", "run": "gitleaks dir . --no-banner", "autofix": false }
  ]
}
